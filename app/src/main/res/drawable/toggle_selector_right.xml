<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when the button is checked (dark sky blue) -->
    <item android:state_checked="true" android:drawable="@color/dark_sky_blue" />
    <!-- Default state (unchecked - light sky blue) -->
    <item android:drawable="@color/light_sky_blue" />
</selector>
