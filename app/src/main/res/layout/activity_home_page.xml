<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD"
    tools:context=".HomePageActivity">

    <!-- Search Bar (Google Maps-like) -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:queryHint="Search Bus Stops"
        android:iconifiedByDefault="false"
        android:background="@drawable/search_bar_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Nearest Bus Stops Window -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_nearest_stops"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#FFFFFF"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header with "See All" Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nearest_bus_stops"
                    android:textSize="18sp"
                    android:textColor="#000"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/see_all"
                    android:textColor="#1976D2" />
            </LinearLayout>

            <!-- List of Nearest Bus Stops -->
            <TextView
                android:id="@+id/stop_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_1"
                android:textSize="16sp"
                android:textColor="#616161"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/stop_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_2"
                android:textSize="16sp"
                android:textColor="#616161"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/stop_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_3"
                android:textSize="16sp"
                android:textColor="#616161"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/stop_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_4"
                android:textSize="16sp"
                android:textColor="#616161"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/stop_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_5"
                android:textSize="16sp"
                android:textColor="#616161" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bus Stop Schedules Window -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_schedules"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_nearest_stops"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#FFFFFF"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bus_stop_schedules"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/schedule_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_schedules_available"
                android:textSize="16sp"
                android:textColor="#616161" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Map Window -->
    <androidx.cardview.widget.CardView
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_schedules"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <!-- Map Fragment -->
        <com.google.android.gms.maps.MapView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:contentDescription="@string/googleMap" />


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
